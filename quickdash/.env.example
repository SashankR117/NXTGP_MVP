# QuickDash MVP — Environment Variables Example
# Copy this file to .env.local for local development.
# DO NOT commit .env.local or secret API keys to Git.

# --- Public Client Variables (Safe to expose to browser) ---
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# --- Private Server-Side Secrets (NEVER expose to browser, no NEXT_PUBLIC_ prefix) ---
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here
GEMINI_API_KEY=your-google-gemini-api-key-here
OPENAI_API_KEY=your-openai-api-key-here
